# Required by Docker Compose. Replace with a strong unique URL-safe secret.
MM_DB_PASSWORD=
MM_DEPLOYMENT_MODE=local
MM_PUBLIC_URL=
# Optional server configuration (Compose explicitly forwards these values).
MM_EMBEDDING_PROVIDER=fastembed
MM_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
MM_EMBEDDING_DIM=384
MM_GUIDANCE_TOKEN_BUDGET=350
MM_MIN_SUCCESSES=2
MM_MIN_RELIABILITY=0.65
MM_STALE_DAYS=90
MM_TRACE_RETENTION_DAYS=30
MM_REQUESTS_PER_MINUTE=120
MM_ALLOWED_HOSTS=127.0.0.1:*,localhost:*
MM_ALLOWED_ORIGINS=http://127.0.0.1:*,http://localhost:*

