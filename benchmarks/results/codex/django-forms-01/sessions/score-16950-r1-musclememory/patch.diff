+from .models import Child, Parent, Poem, Poet, School, UUIDChild, UUIDParent
 
 
 class DeletionTests(TestCase):
+    def test_inline_foreign_key_to_uuid_default(self):
+        formset_class = inlineformset_factory(
+            UUIDParent, UUIDChild, fields="__all__"
+        )
+        parent = UUIDParent()
+        original_id = parent.id
+        data = {
+            "children-TOTAL_FORMS": "1",
+            "children-INITIAL_FORMS": "0",
+            "children-MAX_NUM_FORMS": "0",
+            "children-0-name": "child",
+        }
+        formset = formset_class(data, instance=parent)
+
+        self.assertTrue(formset.is_valid(), formset.errors)
+        self.assertEqual(parent.id, original_id)
+        parent.save()
+        formset.save()
+        self.assertEqual(parent.children.get().parent_id, original_id)
+
