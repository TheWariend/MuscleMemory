+    def test_factory_uses_meta_formfield_callback(self):
+        callback_args = []
+
+        def callback(db_field, **kwargs):
+            callback_args.append(db_field)
+            formfield = db_field.formfield(**kwargs)
+            if formfield:
+                formfield.required = True
+            return formfield
+
+        class BaseForm(forms.ModelForm):
+            class Meta:
+                model = Person
+                fields = "__all__"
+                formfield_callback = staticmethod(callback)
+
+        FactoryForm = modelform_factory(Person, form=BaseForm)
+
+        self.assertTrue(all(field.required for field in FactoryForm.base_fields.values()))
+        self.assertEqual(callback_args, list(Person._meta.fields))
+
