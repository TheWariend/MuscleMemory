+    def test_edit_only(self):
+        author = Author.objects.create(name='Old name')
+        AuthorFormSet = modelformset_factory(
+            Author, fields='__all__', extra=0, edit_only=True,
+        )
+        formset = AuthorFormSet(data={
+            'form-TOTAL_FORMS': '2',
+            'form-INITIAL_FORMS': '1',
+            'form-MAX_NUM_FORMS': '',
+            'form-0-id': str(author.pk),
+            'form-0-name': 'New name',
+            'form-1-name': 'Injected name',
+        })
+        self.assertTrue(formset.is_valid())
+        self.assertEqual(formset.save(), [author])
+        author.refresh_from_db()
+        self.assertEqual(author.name, 'New name')
+        self.assertFalse(Author.objects.filter(name='Injected name').exists())
